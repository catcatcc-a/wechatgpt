+
+// Only bounded, non-identifying metrics leave the logger. Raw JS payloads,
+// error strings, media keys, paths and IDs are deliberately excluded.
+func safeLogFields(fields []interface{}) []interface{} {
+	result := make([]interface{}, 0)
+	for i := 0; i+1 < len(fields); i += 2 {
+		key, ok := fields[i].(string)
+		if !ok {
+			continue
+		}
+		switch key {
+		case "bytes", "status", "size", "duration", "duration_ms", "data_len", "media_len", "chunks", "chunk", "times", "ret":
+			switch fields[i+1].(type) {
+			case int, int32, int64, uint, uint32, uint64, float64:
+				result = append(result, key, fields[i+1])
+			}
+		case "err":
+			result = append(result, "error_type", fmt.Sprintf("%T", fields[i+1]))
+		}
+	}
+	return result
+}
