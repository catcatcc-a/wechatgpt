diff --git a/onebot/server.go b/onebot/server.go
new file mode 100644
index 0000000..f56d782
--- /dev/null
+++ b/onebot/server.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"context"
+	"crypto/hmac"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// Keep authentication at the routing boundary, including the WebSocket
+// handshake. A private mux prevents debug handlers registered on DefaultServeMux
+// from becoming part of the message service.
+func newHTTPHandler(token string, send, websocket http.HandlerFunc) http.Handler {
+	mux := http.NewServeMux()
+	mux.Handle("/send_private_msg", requireToken(token, send))
+	mux.Handle("/send_group_msg", requireToken(token, send))
+	mux.Handle("/ws", requireToken(token, websocket))
+	mux.Handle("/local_status", requireToken(token, http.HandlerFunc(localStatus)))
+	return mux
+}
+
+// Probe the live Frida script, not just the HTTP listener.
+func localStatus(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	result := map[string]any{"hook_verified": false, "login_verified": false}
+	if session != nil && !session.IsDetached() && fridaScript != nil && !fridaScript.IsDestroyed() {
+		ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
+		defer cancel()
+		if state, ok := fridaScript.ExportsCallWithContext(ctx, "localStatus").(map[string]any); ok {
+			result = state
+		}
+	}
+	json.NewEncoder(w).Encode(result)
+}
+
+func requireToken(token string, next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		headers := r.Header.Values("Authorization")
+		var parts []string
+		if len(headers) == 1 {
+			parts = strings.Fields(headers[0])
+		}
+		if token == "" || len(parts) != 2 || !strings.EqualFold(parts[0], "Bearer") ||
+			!hmac.Equal([]byte(parts[1]), []byte(token)) {
+			w.Header().Set("WWW-Authenticate", "Bearer")
+			http.Error(w, "未授权", http.StatusUnauthorized)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
diff --git a/onebot/server_test.go b/onebot/server_test.go
new file mode 100644
index 0000000..fcde5e7
--- /dev/null
+++ b/onebot/server_test.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestMessageRoutesRequireToken(t *testing.T) {
+	const secret = "test-local-secret"
+	for _, path := range []string{"/send_private_msg", "/send_group_msg", "/ws"} {
+		for _, authorization := range []string{"", "Bearer wrong", secret, "Basic " + secret, "Bearer", "Bearer " + secret + " extra"} {
+			t.Run(path+"/"+authorization, func(t *testing.T) {
+				called := false
+				downstream := func(w http.ResponseWriter, r *http.Request) { called = true }
+				handler := newHTTPHandler(secret, downstream, downstream)
+				req := httptest.NewRequest(http.MethodPost, path+"?access_token="+secret, nil)
+				req.Header.Set("Authorization", authorization)
+				response := httptest.NewRecorder()
+				handler.ServeHTTP(response, req)
+				if response.Code != http.StatusUnauthorized || called {
+					t.Fatalf("code=%d downstream_called=%v", response.Code, called)
+				}
+				if strings.Contains(response.Body.String(), secret) {
+					t.Fatal("response leaked token")
+				}
+			})
+		}
+	}
+}
+
+func TestAuthenticatedRoutesReachCorrectHandler(t *testing.T) {
+	send := func(w http.ResponseWriter, r *http.Request) { io.WriteString(w, "send") }
+	websocket := func(w http.ResponseWriter, r *http.Request) { io.WriteString(w, "websocket") }
+	server := httptest.NewServer(newHTTPHandler("secret", send, websocket))
+	defer server.Close()
+	for _, tc := range []struct{ path, want string }{
+		{"/send_private_msg", "send"},
+		{"/send_group_msg", "send"},
+		{"/ws", "websocket"},
+	} {
+		req, err := http.NewRequest(http.MethodGet, server.URL+tc.path, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		req.Header.Set("Authorization", "bearer secret")
+		res, err := server.Client().Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, err := io.ReadAll(res.Body)
+		res.Body.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if res.StatusCode != http.StatusOK || string(body) != tc.want {
+			t.Fatalf("%s: code=%d body=%q", tc.path, res.StatusCode, body)
+		}
+	}
+}
+
+func TestEmptyTokenAndDuplicateHeadersFailClosed(t *testing.T) {
+	for _, token := range []string{"", "secret"} {
+		called := false
+		next := func(w http.ResponseWriter, r *http.Request) { called = true }
+		req := httptest.NewRequest(http.MethodGet, "/ws", nil)
+		req.Header.Add("Authorization", "Bearer secret")
+		if token != "" {
+			req.Header.Add("Authorization", "Bearer wrong")
+		}
+		response := httptest.NewRecorder()
+		newHTTPHandler(token, next, next).ServeHTTP(response, req)
+		if response.Code != http.StatusUnauthorized || called {
+			t.Fatalf("code=%d downstream_called=%v", response.Code, called)
+		}
+	}
+}
+
+func TestDebugRoutesAreNotExposed(t *testing.T) {
+	originalMux := http.DefaultServeMux
+	t.Cleanup(func() { http.DefaultServeMux = originalMux })
+	http.DefaultServeMux = http.NewServeMux()
+	http.DefaultServeMux.HandleFunc("/debug/pprof/", func(w http.ResponseWriter, r *http.Request) {
+		t.Fatal("default mux handler reached")
+	})
+	unused := func(w http.ResponseWriter, r *http.Request) { t.Fatal("message handler reached") }
+	handler := newHTTPHandler("secret", unused, unused)
+	for _, path := range []string{"/test_ws", "/debug/pprof/", "/debug/pprof/cmdline", "/debug/pprof/heap"} {
+		for _, header := range []string{"", "Bearer secret"} {
+			req := httptest.NewRequest(http.MethodPost, path, nil)
+			req.Header.Set("Authorization", header)
+			response := httptest.NewRecorder()
+			handler.ServeHTTP(response, req)
+			if response.Code != http.StatusNotFound {
+				t.Fatalf("%s: code=%d", path, response.Code)
+			}
+		}
+	}
+}
