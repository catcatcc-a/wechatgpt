+++ b/onebot/security_test.go
@@ -0,0 +1,145 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/rs/zerolog"
+)
+
+func TestSendRejectsOversizeAndMalformedBeforeEnqueue(t *testing.T) {
+	valid := `{"user_id":"filehelper","message":[{"type":"text","data":{"text":"fixture"}}]}`
+	for _, tc := range []struct {
+		body   string
+		status int
+	}{
+		{valid + strings.Repeat(" ", maxMessageBytes), 413},
+		{`{"message":"` + strings.Repeat("x", maxMessageBytes) + `"}`, 413},
+		{valid + `{}`, 400},
+		{`{"user_id":"filehelper","message":[null]}`, 400},
+		{`{"user_id":"filehelper","message":[{"type":"text","data":null}]}`, 400},
+	} {
+		req := httptest.NewRequest("POST", "/send_private_msg", strings.NewReader(tc.body))
+		req.ContentLength = -1 // Chunked bodies must be limited too.
+		req.Header.Set("Authorization", "Bearer test")
+		response := httptest.NewRecorder()
+		newHTTPHandler("test", sendHandler, handleWebSocket).ServeHTTP(response, req)
+		if response.Code != tc.status {
+			t.Fatalf("got %d want %d", response.Code, tc.status)
+		}
+	}
+	request := new(SendRequest)
+	if !decodeSendRequest(httptest.NewRecorder(), httptest.NewRequest("POST", "/", strings.NewReader(valid)), request) || request.UserID != "filehelper" {
+		t.Fatal("valid request rejected")
+	}
+}
+
+func TestSlowHTTPHeaderIsClosed(t *testing.T) {
+	server := newHTTPServer("", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("incomplete request reached handler") }))
+	if server.ReadHeaderTimeout <= 0 || server.ReadTimeout <= 0 || server.WriteTimeout < 60*time.Second || server.IdleTimeout <= 0 || server.MaxHeaderBytes > 32768 {
+		t.Fatal("missing or unsuitable production limits")
+	}
+	server.ReadHeaderTimeout = 40 * time.Millisecond
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	go server.Serve(listener)
+	conn, err := net.Dial("tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(time.Second))
+	io.WriteString(conn, "GET / HTTP/1.1\r\nHost: test\r\nX-Slow:")
+	_, err = io.ReadAll(conn)
+	if nerr, ok := err.(net.Error); ok && nerr.Timeout() {
+		t.Fatal("slow header connection stayed open")
+	}
+}
+
+func TestWebsocketLimitsAndMissingParams(t *testing.T) {
+	server := httptest.NewServer(newHTTPHandler("test", sendHandler, handleWebSocket))
+	defer server.Close()
+	conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/ws", http.Header{"Authorization": {"Bearer test"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+	if err := conn.WriteMessage(websocket.TextMessage, []byte(`{"action":"send_private_msg"}`)); err != nil {
+		t.Fatal(err)
+	}
+	_, response, err := conn.ReadMessage()
+	if err != nil || !bytes.Contains(response, []byte("params required")) {
+		t.Fatalf("missing params: %v", err)
+	}
+	conn.WriteMessage(websocket.TextMessage, bytes.Repeat([]byte("x"), maxMessageBytes+1))
+	_, _, err = conn.ReadMessage()
+	if !websocket.IsCloseError(err, websocket.CloseMessageTooBig) {
+		t.Fatalf("oversized websocket not rejected: %v", err)
+	}
+}
+
+func TestPrivateGadgetTokenRequired(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "gadget.token")
+	for _, value := range []string{"", "short", strings.Repeat("x", 129)} {
+		os.WriteFile(path, []byte(value), 0600)
+		if _, err := readGadgetToken(path); err == nil {
+			t.Fatal("invalid credential accepted")
+		}
+	}
+	secret := strings.Repeat("a", 64)
+	os.WriteFile(path, []byte(secret+"\n"), 0600)
+	if token, err := readGadgetToken(path); err != nil || token != secret {
+		t.Fatal("valid credential rejected")
+	}
+	os.Chmod(path, 0644)
+	if _, err := readGadgetToken(path); err == nil {
+		t.Fatal("public credential accepted")
+	}
+	os.Chmod(path, 0600)
+	link := path + "-link"
+	os.Symlink(path, link)
+	if _, err := readGadgetToken(link); err == nil {
