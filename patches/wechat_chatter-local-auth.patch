+func TestLateResponseCannotCompleteAnotherSend(t *testing.T) {
+	replies := make(chan *Buf2RespData, 2)
+	replies <- &Buf2RespData{TaskID: 10}
+	expected := errors.New("current request failed")
+	replies <- &Buf2RespData{TaskID: 11, Err: expected}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if got := waitForSendResponse(ctx, 11, replies); got != expected {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestUnparseableResponseIsNotSuccess(t *testing.T) {
+	HandleBuf2Resp(17, "text", []byte{0xff})
+	result := <-buf2RespChan
+	if result.Err == nil || result.TaskID != 17 {
+		t.Fatalf("unexpected result: %+v", result)
+	}
+}
+
+func TestLocalStatusRequiresTokenAndReportsAbsentSession(t *testing.T) {
+	handler := newHTTPHandler("test-secret", nil, nil)
+	for _, authorized := range []bool{false, true} {
+		req := httptest.NewRequest(http.MethodGet, "/local_status", nil)
+		if authorized {
+			req.Header.Set("Authorization", "Bearer test-secret")
+		}
+		result := httptest.NewRecorder()
+		handler.ServeHTTP(result, req)
+		if !authorized && result.Code != 401 {
+			t.Fatal(result.Code)
+		}
+		if authorized && (result.Code != 200 || result.Body.String() != "{\"hook_verified\":false,\"login_verified\":false}\n") {
+			t.Fatal(result.Body.String())
+		}
+	}
