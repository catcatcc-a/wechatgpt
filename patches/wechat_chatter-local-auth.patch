new file mode 100644
index 0000000..cf87cab
--- /dev/null
+++ b/onebot/server.go
@@ -0,0 +1,121 @@
+package main
+
+import (
+	"context"
+	"crypto/hmac"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"regexp"
+	"strings"
+	"syscall"
+	"time"
+)
+
+const maxMessageBytes = 2 << 20
+
+func readGadgetToken(path string) (string, error) {
+	invalid := errors.New("private Gadget token file required (owned regular file, mode 0600)")
+	fd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return "", invalid
+	}
+	file := os.NewFile(uintptr(fd), "gadget-token")
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 {
+		return "", invalid
+	}
+	owner, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || int(owner.Uid) != os.Getuid() {
+		return "", invalid
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 257))
+	token := strings.TrimSpace(string(data))
+	if err != nil || !regexp.MustCompile(`^[A-Za-z0-9_-]{43,128}$`).MatchString(token) {
+		return "", invalid
+	}
+	return token, nil
+}
+
+func newHTTPServer(address string, handler http.Handler) *http.Server {
+	return &http.Server{Addr: address, Handler: handler, ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout: 15 * time.Second, WriteTimeout: 90 * time.Second, IdleTimeout: 60 * time.Second,
+		MaxHeaderBytes: 16 << 10}
+}
+
+func decodeSendRequest(w http.ResponseWriter, r *http.Request, request *SendRequest) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, maxMessageBytes)
+	// Read through EOF before enqueueing: a valid JSON prefix followed by an
+	// oversized tail must not start a send before it is rejected.
+	data, err := io.ReadAll(r.Body)
+	if err != nil {
+		var oversized *http.MaxBytesError
+		if errors.As(err, &oversized) {
+			http.Error(w, "request too large", http.StatusRequestEntityTooLarge)
+		} else {
+			http.Error(w, "cannot read request", http.StatusBadRequest)
+		}
+		return false
+	}
+	if json.Unmarshal(data, request) != nil {
+		http.Error(w, "invalid JSON", http.StatusBadRequest)
+		return false
+	}
+	for _, message := range request.Message {
+		if message == nil || message.Data == nil {
+			http.Error(w, "null message data", http.StatusBadRequest)
+			return false
+		}
+	}
+	return true
+}
+
+// Keep authentication at the routing boundary, including the WebSocket
+// handshake. A private mux prevents debug handlers registered on DefaultServeMux
+// from becoming part of the message service.
+func newHTTPHandler(token string, send, websocket http.HandlerFunc) http.Handler {
+	mux := http.NewServeMux()
+	mux.Handle("/send_private_msg", requireToken(token, send))
+	mux.Handle("/send_group_msg", requireToken(token, send))
+	mux.Handle("/ws", requireToken(token, websocket))
+	mux.Handle("/local_status", requireToken(token, http.HandlerFunc(localStatus)))
+	return mux
+}
+
+// Probe the live Frida script, not just the HTTP listener.
+func localStatus(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	result := map[string]any{"hook_verified": false, "login_verified": false}
+	if session != nil && !session.IsDetached() && fridaScript != nil && !fridaScript.IsDestroyed() {
+		ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
+		defer cancel()
+		if state, ok := fridaScript.ExportsCallWithContext(ctx, "localStatus").(map[string]any); ok {
+			result = state
+		}
+	}
+	json.NewEncoder(w).Encode(result)
+}
+
+func requireToken(token string, next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		headers := r.Header.Values("Authorization")
+		var parts []string
+		if len(headers) == 1 {
+			parts = strings.Fields(headers[0])
+		}
+		if token == "" || len(parts) != 2 || !strings.EqualFold(parts[0], "Bearer") ||
+			!hmac.Equal([]byte(parts[1]), []byte(token)) {
+			w.Header().Set("WWW-Authenticate", "Bearer")
+			http.Error(w, "未授权", http.StatusUnauthorized)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
