new file mode 100644
index 0000000..9f07fc2
--- /dev/null
+++ b/onebot/gadget_integration_test.go
@@ -0,0 +1,37 @@
+package main
+
+import (
+	"github.com/frida/frida-go/frida"
+	"os"
+	"testing"
+)
+
+// The harness supplies an isolated dummy process, never the WeChat listener.
+func TestIsolatedGadgetAuthentication(t *testing.T) {
+	address := os.Getenv("WECHAT_TEST_GADGET_ADDR")
+	if address == "" {
+		t.Skip("run scripts/test-gadget-auth.py for isolated Frida integration")
+	}
+	if address == "127.0.0.1:27042" {
+		t.Fatal("refusing live WeChat port")
+	}
+	token, err := readGadgetToken(os.Getenv("WECHAT_TEST_GADGET_TOKEN_FILE"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, testToken := range []string{"", "wrong-token", token} {
+		manager := frida.NewDeviceManager()
+		options := frida.NewRemoteDeviceOptions()
+		options.SetToken(testToken)
+		device, err := manager.AddRemoteDevice(address, options)
+		options.Clean()
+		if err == nil {
+			_, err = device.EnumerateProcesses(frida.ScopeMinimal)
+			manager.RemoveRemoteDevice(address)
+		}
+		manager.Clean()
+		if (testToken == token) != (err == nil) {
+			t.Fatal("unexpected Gadget authentication outcome")
+		}
+	}
+}
